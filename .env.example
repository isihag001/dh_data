# Copy this file to .env and fill in your values

# Node.js port (Hostinger assigns this automatically)
PORT=3000

# Secret used to sign session cookies — use a long random string in production
SESSION_SECRET=replace-with-a-long-random-string

# Admin password
# Option 1 (simplest): plaintext
ADMIN_PASSWORD=changeme
# Option 2 (recommended): bcrypt hash — generated with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# ADMIN_PASSWORD_HASH=

# MySQL database (Hostinger hPanel → Databases → MySQL Databases)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=u473429750_admin
MYSQL_PASSWORD=your_database_password_here
MYSQL_DATABASE=yu473429750_data
