# Copy this file to .env and fill in your values

# The port your Node.js app runs on (Hostinger usually assigns this automatically)
PORT=3000

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=replace-with-a-long-random-string

# Admin password
# Option 1 (simplest): set ADMIN_PASSWORD in plaintext
ADMIN_PASSWORD=changeme

# Option 2 (recommended for production): set ADMIN_PASSWORD_HASH instead
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# If both are set, the hash is preferred.
# ADMIN_PASSWORD_HASH=
